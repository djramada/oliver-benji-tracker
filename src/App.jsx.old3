import React, { useState, useEffect } from 'react';
import { Trophy, CheckCircle, RefreshCw, Cloud, CloudOff, User, LogIn, LogOut, Menu } from 'lucide-react';
import { initializeApp } from 'firebase/app';
import { 
  getAuth, 
  onAuthStateChanged, 
  signInAnonymously, 
  signInWithPopup,
  signInWithCustomToken,
  GoogleAuthProvider,
  signOut
} from 'firebase/auth';
import { 
  getFirestore, 
  doc, 
  setDoc, 
  onSnapshot 
} from 'firebase/firestore';

// --- CONFIGURACIÓN DE FIREBASE ---
// El código intenta detectar si está en el editor online o en tu PC
let firebaseConfig;
let appIdRaw;

try {
  if (typeof __firebase_config !== 'undefined') {
    firebaseConfig = JSON.parse(__firebase_config);
    appIdRaw = typeof __app_id !== 'undefined' ? __app_id : 'oliver-benji-app';
  } else {
    throw new Error('Entorno local detectado');
  }
} catch (e) {
  // --- PON AQUÍ TUS DATOS REALES DE FIREBASE ---
  firebaseConfig = {
    apiKey: "AIzaSyCZR6KXJTdgmUM3XsfLtfZEjCJMXKSnr6w", 
    authDomain: "oliver-benji-tracker-db.firebaseapp.com",
    projectId: "oliver-benji-tracker-db",
    storageBucket: "oliver-benji-tracker-db.firebasestorage.app",
    messagingSenderId: "295424223271",
    appId: "1:295424223271:web:1c1c6635049c78e24e4602"
  };
  appIdRaw = "oliver-benji-app";
}

const appId = appIdRaw;
const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);

export default function App() {
  const [episodes, setEpisodes] = useState(initialEpisodes);
  const [filter, setFilter] = useState('all'); 
  const [user, setUser] = useState(null);
  const [isSyncing, setIsSyncing] = useState(false);
  const [isOnline, setIsOnline] = useState(false);

  useEffect(() => {
    const initAuth = async () => {
      if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
        try { await signInWithCustomToken(auth, __initial_auth_token); } 
        catch (e) { await signInAnonymously(auth); }
      } else {
        onAuthStateChanged(auth, (currentUser) => {
          if (currentUser) {
            setUser(currentUser);
            setIsOnline(true);
          } else {
            signInAnonymously(auth).catch((e) => console.error(e));
          }
        });
      }
    };
    initAuth();
  }, []);

  const loginWithGoogle = async () => {
    const provider = new GoogleAuthProvider();
    try { await signInWithPopup(auth, provider); } 
    catch (error) { alert("Error al iniciar sesión. Revisa la consola."); }
  };

  const logout = async () => {
    try { await signOut(auth); } catch (error) { console.error(error); }
  };

  useEffect(() => {
    if (!user) return;
    const docRef = doc(db, 'artifacts', appId, 'users', user.uid, 'data', 'progress');
    setIsSyncing(true);
    const unsubscribe = onSnapshot(docRef, (docSnap) => {
      setIsSyncing(false);
      if (docSnap.exists()) {
        const data = docSnap.data();
        const watchedIds = new Set(data.watchedIds || []);
        setEpisodes(prev => prev.map(ep => ({ ...ep, watched: watchedIds.has(ep.id) })));
      } else {
        setEpisodes(prev => prev.map(ep => ({ ...ep, watched: false })));
      }
    }, () => setIsSyncing(false));
    return () => unsubscribe();
  }, [user]);

  const toggleEpisode = async (id) => {
    const newEpisodes = episodes.map(ep => 
      ep.id === id ? { ...ep, watched: !ep.watched } : ep
    );
    setEpisodes(newEpisodes);

    if (user) {
      const watchedIds = newEpisodes.filter(ep => ep.watched).map(ep => ep.id);
      try {
        const docRef = doc(db, 'artifacts', appId, 'users', user.uid, 'data', 'progress');
        await setDoc(docRef, { watchedIds }, { merge: true });
      } catch (e) { console.error(e); }
    }
  };

  const resetAll = async () => {
    if (window.confirm('¿Borrar todo el progreso?')) {
      const resetEpisodes = initialEpisodes.map(ep => ({ ...ep, watched: false }));
      setEpisodes(resetEpisodes);
      if (user) {
        const docRef = doc(db, 'artifacts', appId, 'users', user.uid, 'data', 'progress');
        await setDoc(docRef, { watchedIds: [] });
      }
    }
  };

  const watchedCount = episodes.filter(ep => ep.watched).length;
  const progressPercentage = Math.round((watchedCount / episodes.length) * 100);
  const displayedEpisodes = episodes.filter(ep => {
    if (filter === 'watched') return ep.watched;
    if (filter === 'pending') return !ep.watched;
    return true;
  });

  return (
    <div className="min-h-screen bg-gray-50 font-sans text-gray-800 pb-safe">
      
      {/* HEADER */}
      <header className="bg-gradient-to-r from-green-600 to-green-700 text-white sticky top-0 z-30 shadow-md">
        <div className="max-w-3xl mx-auto px-4 py-3">
          <div className="flex justify-between items-center mb-3">
            <div className="flex items-center gap-2">
              <Trophy className="h-5 w-5 md:h-6 md:w-6 text-yellow-300" />
              <h1 className="text-lg md:text-2xl font-bold tracking-tight leading-none">Oliver y Benji</h1>
            </div>

            <div className="flex items-center gap-2">
              {user && !user.isAnonymous ? (
                 <button onClick={logout} className="flex items-center gap-2 bg-black/20 hover:bg-black/30 px-3 py-1.5 rounded-full transition-colors text-xs font-medium">
                    <User size={14} className="text-green-100" />
                    <span className="max-w-[80px] truncate">{user.displayName?.split(' ')[0]}</span>
                    <LogOut size={14} className="ml-1 text-red-200" />
                 </button>
              ) : (
                <button onClick={loginWithGoogle} className="flex items-center gap-2 bg-white text-green-700 px-3 py-1.5 rounded-full text-xs font-bold shadow-sm active:scale-95 transition-transform">
                  <LogIn size={14} />
                  <span>Entrar</span>
                </button>
              )}
            </div>
          </div>

          <div className="flex justify-between items-end text-xs md:text-sm mb-1.5 px-0.5 opacity-90">
            <span>Has visto <b>{watchedCount}</b> de <b>{episodes.length}</b></span>
            {isOnline && (
               <span className={`flex items-center gap-1 text-[10px] ${isSyncing ? 'animate-pulse text-yellow-200' : 'text-green-100'}`}>
                 <Cloud size={12} /> {isSyncing ? 'Guardando...' : 'Guardado'}
               </span>
            )}
          </div>

          <div className="w-full bg-black/20 rounded-full h-3 overflow-hidden backdrop-blur-sm">
            <div 
              className="bg-yellow-400 h-full transition-all duration-500 ease-out relative"
              style={{ width: `${progressPercentage}%` }}
            />
          </div>
        </div>
      </header>

      {/* CONTROLES FLOTANTES */}
      <div className="sticky top-[100px] z-20 bg-gray-50/95 backdrop-blur-md border-b border-gray-200 shadow-sm">
        <div className="max-w-3xl mx-auto px-4 py-3 flex items-center justify-between gap-3">
          <div className="flex bg-white rounded-lg p-1 shadow-sm border border-gray-200 w-full sm:w-auto">
            {['all', 'pending', 'watched'].map((f) => (
              <button
                key={f}
                onClick={() => setFilter(f)}
                className={`flex-1 sm:flex-none px-3 py-2 text-xs sm:text-sm font-medium rounded-md transition-all duration-200 ${
                  filter === f 
                    ? 'bg-blue-600 text-white shadow-sm' 
                    : 'text-gray-500 hover:bg-gray-50'
                }`}
              >
                {f === 'all' ? 'Todos' : f === 'pending' ? 'Faltan' : 'Vistos'}
              </button>
            ))}
          </div>
          
          <button 
            onClick={resetAll}
            className="p-2.5 text-gray-400 hover:text-red-500 hover:bg-red-50 rounded-full transition-colors active:scale-90"
            title="Reiniciar"
          >
            <RefreshCw size={18} />
          </button>
        </div>
      </div>

      {/* LISTA DE EPISODIOS */}
      <main className="max-w-3xl mx-auto p-4 pb-24">
        <div className="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
          {displayedEpisodes.length === 0 ? (
            <div className="p-12 text-center text-gray-400 flex flex-col items-center">
              <CheckCircle size={48} className="mb-4 opacity-20" />
              <p>No hay episodios aquí</p>
            </div>
          ) : (
            <ul className="divide-y divide-gray-50">
              {displayedEpisodes.map((ep) => (
                <li 
                  key={ep.id} 
                  onClick={() => toggleEpisode(ep.id)}
                  className={`
                    group flex items-center p-4 cursor-pointer select-none transition-colors active:bg-blue-50
                    ${ep.watched ? 'bg-gray-50/50' : 'bg-white hover:bg-gray-50'}
                  `}
                >
                  {/* Checkbox personalizado */}
                  <div className="relative flex-shrink-0 mr-4">
                    <div className={`
                      w-7 h-7 rounded-full border-2 flex items-center justify-center transition-all duration-300
                      ${ep.watched 
                        ? 'bg-green-500 border-green-500 scale-100' 
                        : 'bg-white border-gray-200 group-hover:border-blue-300'}
                    `}>
                      <CheckCircle 
                        size={16} 
                        className={`text-white transition-transform duration-300 ${ep.watched ? 'scale-100' : 'scale-0'}`} 
                        strokeWidth={3}
                      />
                    </div>
                  </div>
                  
                  <div className="flex-1 min-w-0">
                    <div className="flex flex-col">
                      <span className={`
                        text-xs font-bold tracking-wider mb-0.5 transition-colors
                        ${ep.watched ? 'text-gray-400' : 'text-blue-600'}
                      `}>
                        #{ep.id}
                      </span>
                      <h3 className={`
                        text-base sm:text-lg font-medium leading-snug transition-all
                        ${ep.watched ? 'text-gray-400 line-through decoration-2 decoration-gray-200' : 'text-gray-800'}
                      `}>
                        {ep.title}
                      </h3>
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          )}
        </div>
      </main>
    </div>
  );
}

